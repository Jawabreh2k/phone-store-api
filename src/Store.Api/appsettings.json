{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Store": ""
  },
  "FileStorage": {
    "RootPath": "uploads",
    "RequestPath": "/uploads"
  },
  "Storefront": {
    "BaseUrl": ""
  },
  "Notifications": {
    "CustomerChannels": [ "Email" ],
    "Messaging": {
      "Provider": "Log",
      "Twilio": {
        "AccountSid": "",
        "SmsFrom": "",
        "MessagingServiceSid": "",
        "WhatsAppFrom": ""
      }
    }
  },
  "Outbox": {
    "BatchSize": 20,
    "PollInterval": "00:00:05",
    "LeaseDuration": "00:02:00",
    "MaxAttempts": 8,
    "Backoff": [ "00:00:30", "00:02:00", "00:10:00", "01:00:00", "06:00:00" ],
    "RetentionDays": 14,
    "CleanupInterval": "01:00:00",
    "DegradedAfter": "00:15:00"
  },
  "Seed": {
    "ApplyMigrations": false,
    "SampleData": false
  }
}
